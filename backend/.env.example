DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# Classifier backend: "tfidf" (default, lightweight) or "embeddings"
# "embeddings" requires `pip install -r requirements-embeddings.txt`.
CHATBOT_CLASSIFIER_BACKEND=tfidf
CHATBOT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
